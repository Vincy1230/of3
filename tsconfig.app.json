{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,

    // src/seo/meta.mjs is deliberately zero-dependency plain JS (so the
    // build-time Node script scripts/prerender-locales.mjs can import it
    // directly too); this option lets its types be inferred straight from
    // its object literals instead of hand-writing an ambient module
    // declaration that can drift out of sync with the implementation.
    "allowJs": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
